# Supabase project credentials.
# Find these at: https://supabase.com/dashboard/project/_/settings/api
# Leave blank to run without accounts — everything still works and progress stays
# on the device.
#
# The publishable key is meant to be public: it reaches the database only through
# row-level security, which limits every learner to their own row.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
